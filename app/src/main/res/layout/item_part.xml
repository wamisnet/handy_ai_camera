<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="10dp" android:layout_marginBottom="8dp" android:background="#12000000">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <EditText android:id="@+id/editPartName" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="@string/part_name" android:inputType="text" />
        <Button android:id="@+id/btnRoi" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROI" />
    </LinearLayout>
    <CheckBox android:id="@+id/checkMirror" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/allow_mirror" />
    <TextView android:id="@+id/viewCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
        <LinearLayout android:id="@+id/thumbStrip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
    </HorizontalScrollView>
</LinearLayout>
